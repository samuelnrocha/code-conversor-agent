# ========================================================================
# EXEMPLO DE CONFIGURAÇÃO DE AMBIENTE (SEGURO PARA COMMIT)
# Copie para .env e preencha as credenciais reais no servidor seguro.
# ========================================================================

DB_DRIVER=your_db_driver_here
DB_HOST=your_db_host_here
DB_NAME=your_db_name_here
DB_PASSWORD=your_db_password_here
DB_PORT=your_db_port_here
DB_USER=your_db_user_here
PAYMENTSERVICE_APIKEY=your_paymentservice_apikey_here
PAYMENTSERVICE_WEBHOOKSECRET=your_paymentservice_webhooksecret_here
